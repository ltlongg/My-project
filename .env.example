# Sao chép thành .env rồi điền giá trị. File .env không được đưa vào git.
# `bash scripts/setup-keys.sh` dẫn từng bước lấy các giá trị này và tự ghi vào .env.

# Postgres của môi trường phát triển (xem compose.yaml)
DATABASE_URL=postgresql+psycopg://bulletin:bulletin@127.0.0.1:54320/bulletin

# Token của bot Telegram, lấy từ @BotFather
TELEGRAM_BOT_TOKEN=

# Mã của nhóm Telegram thử (số âm); dữ liệu khởi tạo dùng nó làm Kênh đăng đầu tiên
TELEGRAM_CHAT_ID=

# Mã người dùng Telegram của chủ hệ thống: bot nhắn riêng tới đây và nhận diện Phản hồi của chủ
TELEGRAM_OWNER_ID=

# Endpoint LLM tương thích OpenAI: địa chỉ (thường kết thúc bằng /v1) và khoá
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Model mặc định, và model riêng của Sơ tuyển, Biên tập và Kiểm chứng (để trống thì dùng MODEL);
# xem docs/llm-endpoint.md
MODEL=
SHORTLIST_MODEL=
EDITOR_MODEL=
VERIFIER_MODEL=

# Dịch vụ tạo vector nhúng để gom Tin (endpoint tương thích OpenAI, địa chỉ không gồm /embeddings).
# Khoá lấy ở jina.ai; xem docs/clustering.md
EMBEDDING_BASE_URL=https://api.jina.ai/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=jina-embeddings-v5-text-small

# Công cụ tìm kiếm web của Biên tập: tavily (mặc định) hoặc brave, kèm khoá của công cụ được chọn
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_API_KEY=

# Langfuse bản cloud, nơi ghi vết các lần gọi của agent.
# Địa chỉ theo vùng: https://cloud.langfuse.com (EU), https://us.cloud.langfuse.com (US),
# https://jp.cloud.langfuse.com (Nhật)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
